---
import Layout from '../layouts/Layout.astro';
import { memeTemplates } from '../data/meme-templates.js';
import drakeFrontpageLayout from '../../meme-layout-3.json';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const templates = memeTemplates.map((template) => ({
	id: template.id,
	name: template.name,
	src: `${base}memes/${template.filename}`,
	defaultBoxes: template.defaultBoxes
}));
const initialBoxes = drakeFrontpageLayout.boxes;
---

<Layout title="Meme Generator" description="Create memes in the browser and export them as images.">
	<div class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-6 px-4 py-6 lg:px-6">
		<header class="hero overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-xl">
			<div class="hero-content justify-start">
				<div class="max-w-2xl space-y-3">
					<h1 class="text-4xl font-black tracking-tight text-base-content sm:text-5xl">Meme Generator</h1>
					<p class="text-base text-base-content/70 sm:text-lg">
						Pick a built-in meme, upload your own image, add draggable text boxes, and export the result.
						Uploads stay in your browser only.
					</p>
				</div>
			</div>
		</header>

		<main
			id="meme-editor"
			class="grid gap-6 lg:grid-cols-[20rem_minmax(0,1fr)_20rem]"
			data-templates={JSON.stringify(templates)}
			data-default-image={templates[0].src}
			data-initial-boxes={JSON.stringify(initialBoxes)}
		>
			<section class="card border border-base-300 bg-base-100 shadow-xl">
				<div class="card-body gap-4">
					<div class="flex flex-wrap items-start justify-between gap-3">
						<div>
							<h2 class="card-title">Editor</h2>
							<p id="active-image-name" class="text-sm text-base-content/60">Drake Hotline Bling</p>
						</div>
						<div class="flex flex-wrap justify-end gap-2">
							<div class="join">
								<button id="add-text-box" type="button" class="btn btn-primary join-item">Add text box</button>
								<button id="download-meme" type="button" class="btn btn-secondary join-item">Download PNG</button>
							</div>
							<div class="join">
								<button id="export-layout" type="button" class="btn btn-outline join-item">Export layout</button>
								<label class="btn btn-outline join-item" for="import-layout">Import layout</label>
							</div>
							<input id="import-layout" type="file" accept="application/json,.json" class="hidden" />
						</div>
					</div>

					<div class="rounded-box border border-dashed border-base-300 bg-base-200/70 p-3 sm:p-4">
						<div id="editor-stage" class="meme-stage mx-auto max-w-full">
							<img id="editor-image" src={templates[0].src} alt="Selected meme template" class="block h-auto w-full select-none" />
							<div id="text-layer" class="pointer-events-none absolute inset-0"></div>
						</div>
					</div>

					<p class="text-sm text-base-content/60">
						Drag a caption to move it. Use the corner handle to resize its box. Layout export/import saves just the text box positions and styles.
					</p>
				</div>
			</section>

			<aside class="card border border-base-300 bg-base-100 shadow-xl">
				<div class="card-body gap-4">
					<div>
						<h2 class="card-title">Caption settings</h2>
						<p class="text-sm text-base-content/60">Select a text box in the preview to edit it.</p>
					</div>

					<div id="empty-selection" class="rounded-box border border-dashed border-base-300 bg-base-200/70 p-4 text-sm text-base-content/70">
						Select a text box to change text, alignment, and sizing.
					</div>

					<form id="caption-form" class="hidden flex-col gap-4">
						<label class="form-control gap-2">
							<span class="label-text font-semibold">Text</span>
							<textarea id="text-input" class="textarea textarea-bordered min-h-28" placeholder="Type your meme text"></textarea>
						</label>

						<label class="form-control gap-2">
							<span class="label-text font-semibold">Alignment</span>
							<select id="align-input" class="select select-bordered">
								<option value="left">Left</option>
								<option value="center">Center</option>
								<option value="right">Right</option>
							</select>
						</label>

						<label class="form-control gap-2">
							<div class="flex items-center justify-between text-sm">
								<span class="label-text font-semibold">Font size</span>
								<span id="font-size-value" class="font-mono text-base-content/60"></span>
							</div>
							<input id="font-size-input" type="range" min="20" max="120" step="1" class="range range-primary" />
						</label>

						<label class="form-control gap-2">
							<div class="flex items-center justify-between text-sm">
								<span class="label-text font-semibold">Outline width</span>
								<span id="outline-width-value" class="font-mono text-base-content/60"></span>
							</div>
							<input id="outline-width-input" type="range" min="0" max="8" step="0.5" class="range range-secondary" />
						</label>

						<label class="form-control gap-2">
							<div class="flex items-center justify-between text-sm">
								<span class="label-text font-semibold">Rotation</span>
								<span id="rotation-value" class="font-mono text-base-content/60"></span>
							</div>
							<input id="rotation-input" type="range" min="-180" max="180" step="1" class="range range-accent" />
						</label>

						<div class="grid grid-cols-2 gap-3">
							<label class="form-control gap-2">
								<div class="flex items-center justify-between text-sm">
									<span class="label-text font-semibold">Width</span>
									<span id="width-value" class="font-mono text-base-content/60"></span>
								</div>
								<input id="width-input" type="range" min="15" max="100" step="1" class="range range-secondary" />
							</label>

							<label class="form-control gap-2">
								<div class="flex items-center justify-between text-sm">
									<span class="label-text font-semibold">Height</span>
									<span id="height-value" class="font-mono text-base-content/60"></span>
								</div>
								<input id="height-input" type="range" min="8" max="100" step="1" class="range range-accent" />
							</label>
						</div>

						<div class="grid grid-cols-2 gap-3">
							<label class="form-control gap-2">
								<div class="flex items-center justify-between text-sm">
									<span class="label-text font-semibold">X position</span>
									<span id="x-value" class="font-mono text-base-content/60"></span>
								</div>
								<input id="x-input" type="range" min="0" max="100" step="1" class="range range-primary" />
							</label>

							<label class="form-control gap-2">
								<div class="flex items-center justify-between text-sm">
									<span class="label-text font-semibold">Y position</span>
									<span id="y-value" class="font-mono text-base-content/60"></span>
								</div>
								<input id="y-input" type="range" min="0" max="100" step="1" class="range range-secondary" />
							</label>
						</div>

						<div class="flex gap-3 pt-2">
							<button id="duplicate-text-box" type="button" class="btn btn-outline flex-1">Duplicate</button>
							<button id="delete-text-box" type="button" class="btn btn-error btn-outline flex-1">Delete</button>
						</div>
					</form>
				</div>
			</aside>

			<aside class="card border border-base-300 bg-base-100 shadow-xl">
				<div class="card-body gap-4">
					<div>
						<h2 class="card-title">Templates</h2>
					</div>

					<label class="form-control gap-2">
						<span class="label-text font-semibold">Upload your own image</span>
						<input id="image-upload" type="file" accept="image/*" class="file-input file-input-bordered w-full" />
						<span class="text-xs text-base-content/60">Local browser only. Nothing is stored.</span>
					</label>

					<div id="template-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-2 xl:grid-cols-2">
					</div>

					<div class="flex items-center justify-between gap-3 text-sm text-base-content/60">
						<p id="template-page-info">Page 1 of {Math.ceil(templates.length / 8)}</p>
						<div class="join">
							<button id="template-prev" type="button" class="btn btn-sm btn-outline join-item">Prev</button>
							<button id="template-next" type="button" class="btn btn-sm btn-outline join-item">Next</button>
						</div>
					</div>
				</div>
			</aside>
		</main>
	</div>

	<script>
		import '../scripts/meme-editor.js';
	</script>
</Layout>
